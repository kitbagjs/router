{
  "name": "@kitbag/router",
  "private": false,
  "version": "0.25.0",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kitbagjs/router/issues"
  },
  "keywords": [
    "typescript",
    "router",
    "vue",
    "vue-router",
    "types",
    "typed"
  ],
  "homepage": "https://github.com/kitbagjs/router#readme",
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "build:watch": "vite build --watch --minify=false",
    "dev": "vite build --watch --minify=false",
    "test": "vitest",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "types": "vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "vite build && typedoc && sleep 5 && node ./scripts/api.js"
  },
  "type": "module",
  "files": [
    "dist",
    "AGENTS.md",
    "skills"
  ],
  "main": "./dist/kitbag-router.umd.cjs",
  "module": "./dist/kitbag-router.js",
  "types": "./dist/kitbag-router.d.ts",
  "exports": {
    ".": {
      "import": "./dist/kitbag-router.js",
      "require": "./dist/kitbag-router.umd.cjs"
    }
  },
  "devDependencies": {
    "@kitbag/eslint-config": "1.0.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-core": "^3.3.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^6.0.3",
    "valibot": "^1.0.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8",
    "zod": "4.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "zod": "4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@vue/devtools-api": "^8.2.1"
  }
}
