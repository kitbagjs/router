{
  "name": "@kitbag/router",
  "private": false,
  "version": "0.31.0",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kitbagjs/router/issues"
  },
  "keywords": [
    "typescript",
    "router",
    "vue",
    "vue-router",
    "types",
    "typed"
  ],
  "homepage": "https://github.com/kitbagjs/router#readme",
  "scripts": {
    "build": "vite build && vite build --config vite.plugin.config.ts",
    "prepublishOnly": "npm run build",
    "build:watch": "vite build --watch --minify=false",
    "dev": "vite build --watch --minify=false",
    "test": "vitest",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "types": "vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate": "vite build && typedoc && sleep 5 && node ./scripts/api.js"
  },
  "type": "module",
  "bin": {
    "router": "./bin/router.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "main": "./dist/kitbag-router.umd.cjs",
  "module": "./dist/kitbag-router.js",
  "types": "./dist/kitbag-router.d.ts",
  "exports": {
    ".": {
      "import": "./dist/kitbag-router.js",
      "require": "./dist/kitbag-router.umd.cjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/plugin/vite.js",
      "require": "./dist/plugin/vite.cjs"
    }
  },
  "devDependencies": {
    "@kitbag/eslint-config": "1.0.6",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-core": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "arktype": "^2.2.9",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "valibot": "^1.0.0",
    "view-transitions-mock": "^1.1.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.8",
    "zod": "4.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/devtools-api": "^8.2.1",
    "fast-glob": "^3.3.3",
    "magic-string": "^0.30.21",
    "ts-morph": "^28.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
